\begin{document}

\title{The Hot-First Protocol: Precise Energy Measurement for Implementations of Population-Based Optimization Algorithms in Multi-Die Systems}

\author{
\IEEEauthorblockN{JJ Merelo}\\
\IEEEauthorblockA{Department of Computer Engineering, Automatics and Robotics / CITIC, University of Granada, Spain\\
Email: jmerelo@ugr.es; ORCID:0000-0002-1385-9741\\}
